{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-prison/data/tasks.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "coords": {
          "description": "Place: Stand where the player should work and use your position.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "seconds": {
          "description": "Work time",
          "type": "integer",
          "minimum": 3,
          "maximum": 120
        },
        "minutesOff": {
          "description": "Minutes served: How much shorter the sentence gets each time.",
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "cooldown": {
          "description": "Wait before working here again: Seconds before the same character can work at this spot again.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "label",
        "coords",
        "seconds",
        "minutesOff",
        "cooldown"
      ]
    }
  },
  "additionalProperties": false
}
